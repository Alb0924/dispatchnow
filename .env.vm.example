# Windows 11 后端 -> 已有 VMware / CentOS 虚拟机服务。
# 有自己的 .env 时保留原文件，只核对这些键；不要覆盖已有密码。
# 新目录使用时复制为根目录 .env，并填入自己的密码。以 UTF-8 保存。
# KEY=value，不加引号、export 或行尾注释。不要把此文件当成 Docker 初始化配置。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

MYSQL_HOST=192.168.117.129
MYSQL_PORT=3306
MYSQL_DATABASE=project01
MYSQL_USER=kkddmm
MYSQL_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

REDIS_HOST=192.168.117.129
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

RABBITMQ_HOST=192.168.117.129
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=kkddmm
RABBITMQ_PASSWORD=REPLACE_WITH_YOUR_RABBITMQ_PASSWORD
RABBITMQ_VIRTUAL_HOST=delivery_now
