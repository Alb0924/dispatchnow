<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.dispatchnow</groupId>
    <artifactId>dispatchnow-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DispatchNow</name>
    <description>同城即时取送平台 模块化单体</description>

    <modules>
        <module>dispatchnow-account</module>
        <module>dispatchnow-fulfillment</module>
        <module>dispatchnow-pricing</module>
        <module>dispatchnow-payment</module>
        <module>dispatchnow-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-11-02T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dispatchnow</groupId>
                <artifactId>dispatchnow-account</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dispatchnow</groupId>
                <artifactId>dispatchnow-fulfillment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dispatchnow</groupId>
                <artifactId>dispatchnow-pricing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dispatchnow</groupId>
                <artifactId>dispatchnow-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>verify-build-environment</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>请使用 JDK 21。检查 JAVA_HOME 和 IDE 的 Project SDK。</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.11,3.10)</version>
                                    <message>请从项目根目录运行 Maven Wrapper。</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
